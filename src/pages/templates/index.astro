---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TemplatesTabs from "@/components/TemplatesTabs.astro";
import { templatesIntro } from "@/content/templates";
import { localizePath } from "@/lib/i18n";

const locale = "en";
---

<BaseLayout active="templates" description={templatesIntro.summary.en} locale={locale} path="/templates/" title="Hermes Agent Templates Directory">
  <PageHero
    className="page-hero templates-hero"
    ctas={[
      { href: "#templates-directory", label: "Browse by work goal", variant: "primary" },
      { href: localizePath("/#quick-start", locale), label: "Review Quick Start first", variant: "secondary" },
    ]}
    kicker={templatesIntro.kicker}
    summary={templatesIntro.summary.en}
    title={templatesIntro.title.en}
  />
  <div id="templates-directory">
    <TemplatesTabs locale={locale} />
  </div>
</BaseLayout>
