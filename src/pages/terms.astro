---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/Callout.astro";
import { getEntryBySlug } from "@/lib/content";

const entry = await getEntryBySlug("pages", "en", "terms");
if (!entry) {
  throw new Error("Missing pages/terms content");
}

const { Content } = await entry.render();
---

<BaseLayout active="none" description="Terms for Hermes Agent Playbook." locale="en" path="/terms/" title="Terms | Hermes Agent Playbook">
  <article class="section card page-prose">
    <h1>Terms</h1>
    <Content components={{ Callout }} />
  </article>
</BaseLayout>
