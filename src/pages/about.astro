---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/Callout.astro";
import { getEntryBySlug } from "@/lib/content";

const entry = await getEntryBySlug("pages", "en", "about");
if (!entry) {
  throw new Error("Missing pages/about content");
}

const { Content } = await entry.render();
---

<BaseLayout active="none" description="About Hermes Agent Playbook." locale="en" path="/about/" title="About | Hermes Agent Playbook">
  <article class="section card page-prose">
    <h1>About</h1>
    <Content components={{ Callout }} />
  </article>
</BaseLayout>
