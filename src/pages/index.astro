---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import QuickStartCard from "@/components/QuickStartCard.astro";
import HomeLearnFeed from "@/components/HomeLearnFeed.astro";
import HomeSkillsFeed from "@/components/HomeSkillsFeed.astro";
import HomeTemplatesFeed from "@/components/HomeTemplatesFeed.astro";
import HomeTroubleshootFeed from "@/components/HomeTroubleshootFeed.astro";
import {
  homeHero,
  quickStartEntries,
  quickStartIntro,
  learnPreview,
  templatePreview,
  troubleshootPreview,
} from "@/content/site";
import { localizePath } from "@/lib/i18n";

const locale = "en";
---

<BaseLayout
  active="home"
  description={homeHero.summary.en}
  locale={locale}
  path="/"
  title="Quick Start for Hermes Agent Beginners"
>
  <PageHero
    className="home-hero"
    ctas={[
      { href: "#quick-start", label: homeHero.ctas[0].label.en, variant: homeHero.ctas[0].variant },
      { href: localizePath(homeHero.ctas[1].href, locale), label: homeHero.ctas[1].label.en, variant: homeHero.ctas[1].variant },
      { href: localizePath(homeHero.ctas[2].href, locale), label: homeHero.ctas[2].label.en, variant: homeHero.ctas[2].variant },
    ]}
    kicker={homeHero.kicker}
    summary={homeHero.summary.en}
    title={homeHero.title.en}
  >
    <div class="home-signal-strip">
      <div class="home-signal-card home-signal-card-primary">
        <span class="hero-rail-label">Primary route</span>
        <strong>5 linked step guides</strong>
        <p>One guided path from mental model to first useful loop.</p>
      </div>
      <div class="home-signal-card">
        <span class="hero-rail-label">Outcome</span>
        <strong>Channel + result + recovery</strong>
        <p>Get one real loop working and know where to go when it fails.</p>
      </div>
    </div>
    <div slot="aside">
      <div class="hero-briefing">
        <div class="hero-briefing-head">
          <p class="eyebrow">First-run control panel</p>
          <h2>{homeHero.sideTitle.en}</h2>
        </div>
        <div class="hero-briefing-stack">
          {
            homeHero.sideItems.map((item, index) => (
              <div class="hero-briefing-row">
                <span>{`0${index + 1}`}</span>
                <p>{item.en}</p>
              </div>
            ))
          }
        </div>
        <div class="hero-briefing-note">
          <span>Target time</span>
          <strong>30 minutes</strong>
          <p>Enough to establish the mental model and prove one useful workflow.</p>
        </div>
      </div>
    </div>
  </PageHero>

  <section class="section section-quickstart" id="quick-start">
    <SectionHeading title={quickStartIntro.title.en} summary={quickStartIntro.summary.en} />
    <div class="quick-start-overview callout">
      <div class="quick-start-overview-item">
        <span class="hero-rail-label">Format</span>
        <strong>5 linked step guides</strong>
        <p>Each card opens a dedicated tutorial instead of hiding the detail in the homepage.</p>
      </div>
      <div class="quick-start-overview-item">
        <span class="hero-rail-label">Goal</span>
        <strong>From setup to one useful loop</strong>
        <p>Use the path to establish the mental model, verify the stack, connect one channel, and ship one result.</p>
      </div>
      <div class="quick-start-overview-item">
        <span class="hero-rail-label">If it breaks</span>
        <strong>Route into Troubleshoot quickly</strong>
        <p>The last step is there so first-run failure becomes a recoverable path instead of a dead end.</p>
      </div>
    </div>
    <div class="grid cols-2 quick-start-grid">
      {
        quickStartEntries.map((entry) => (
          <QuickStartCard
            ctaLabel={entry.cta.label.en}
            entry={{
              step: entry.step,
              title: entry.title.en,
              summary: entry.summary.en,
              bullets: entry.bullets.en,
            }}
            href={localizePath(`/quick-start/${entry.slug}`, locale)}
          />
        ))
      }
    </div>
  </section>

  <section class="section section-preview section-learn-preview home-module home-module-learn">
    <SectionHeading actionHref={localizePath(learnPreview.cta.href, locale)} actionLabel={learnPreview.cta.label.en} title={learnPreview.title.en} summary={learnPreview.summary.en} />
    <HomeLearnFeed locale={locale} />
  </section>

  <section class="section section-preview section-templates-preview home-module home-module-templates">
    <SectionHeading actionHref={localizePath("/templates", locale)} actionLabel="Browse all templates" title={templatePreview.title.en} summary={templatePreview.summary.en} />
    <HomeTemplatesFeed locale={locale} />
  </section>

  <section class="section section-preview section-skills-preview home-module home-module-skills">
    <SectionHeading
      actionHref="https://hermes-agent.nousresearch.com/docs/skills"
      actionLabel="Browse official skills"
      title="Explore Hermes skills by scenario"
      summary="Use the official Hermes skills categories as a practical map: start from the scenario you care about, inspect a few relevant skills, then jump into the full skills hub."
    />
    <HomeSkillsFeed locale={locale} />
  </section>

  <section class="section section-preview section-troubleshoot-preview home-module home-module-troubleshoot">
    <SectionHeading actionHref={localizePath(troubleshootPreview.cta.href, locale)} actionLabel={troubleshootPreview.cta.label.en} title={troubleshootPreview.title.en} summary={troubleshootPreview.summary.en} />
    <HomeTroubleshootFeed locale={locale} />
  </section>
</BaseLayout>
