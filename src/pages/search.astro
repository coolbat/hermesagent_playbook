---
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = "en";
---

<BaseLayout active="none" description="Search across Hermes Agent quick start guides, templates, and troubleshooting pages." locale={locale} path="/search/" title="Search | Hermes Agent Playbook">
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </Fragment>

  <section class="section search-page search-page--en">
    <div class="search-shell card">
      <p class="eyebrow">SEARCH</p>
      <h1>Find the next useful answer fast.</h1>
      <p class="sub">Search across Quick Start, Learn, Templates, Troubleshoot, and the trust pages without leaving the playbook.</p>
      <div class="search-root" id="search-root">
        <p class="search-loading">Loading search…</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const loadPagefindUi = async () => {
      if (window.PagefindUI) return window.PagefindUI;

      await new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-pagefind-ui]');
        if (existing instanceof HTMLScriptElement) {
          existing.addEventListener("load", () => resolve(window.PagefindUI), { once: true });
          existing.addEventListener("error", reject, { once: true });
          return;
        }

        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.async = true;
        script.dataset.pagefindUi = "true";
        script.addEventListener("load", () => resolve(window.PagefindUI), { once: true });
        script.addEventListener("error", reject, { once: true });
        document.head.appendChild(script);
      });

      return window.PagefindUI;
    };

    const initSearch = async () => {
      const root = document.querySelector("#search-root");
      if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

      try {
        root.innerHTML = "";
        const PagefindUI = await loadPagefindUi();
        if (!PagefindUI) {
          throw new Error("Pagefind UI script loaded but window.PagefindUI is missing");
        }

        new PagefindUI({
          element: "#search-root",
          bundlePath: "/pagefind/",
          showImages: false,
          showSubResults: true,
          resetStyles: false,
          autofocus: true,
          translations: {
            placeholder: "Search guides, templates, and fixes",
            zero_results: "No results yet. Try a symptom, topic, or tag.",
            clear_search: "Clear search",
            load_more: "Load more results",
          },
        });
        root.dataset.ready = "true";
      } catch (error) {
        root.innerHTML = '<p class="search-loading">Search failed to load. Refresh once, then check that <code>/pagefind/pagefind-ui.js</code> is reachable.</p>';
        console.error("Failed to initialize search", error);
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSearch, { once: true });
    } else {
      initSearch();
    }
  </script>
</BaseLayout>
