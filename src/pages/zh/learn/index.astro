---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LearnTabs from "@/components/LearnTabs.astro";
import PageHero from "@/components/PageHero.astro";
import { learnIntro } from "@/content/learn";
import { localizePath } from "@/lib/i18n";

const locale = "zh";
---

<BaseLayout active="learn" description={learnIntro.summary.zh} locale={locale} path="/learn/" title="Hermes Agent Learn 资源中心">
  <PageHero
    className="page-hero learn-hero"
    ctas={[
      { href: localizePath("/#quick-start", locale), label: learnIntro.ctas[0].label.zh, variant: learnIntro.ctas[0].variant },
      { href: localizePath(learnIntro.ctas[1].href, locale), label: learnIntro.ctas[1].label.zh, variant: learnIntro.ctas[1].variant },
    ]}
    kicker={learnIntro.kicker}
    summary={learnIntro.summary.zh}
    title={learnIntro.title.zh}
  />
  <LearnTabs locale={locale} />
</BaseLayout>
