---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/Callout.astro";
import { getEntryBySlug } from "@/lib/content";

const entry = await getEntryBySlug("pages", "zh", "terms");
if (!entry) {
  throw new Error("Missing pages/terms zh content");
}

const { Content } = await entry.render();
---

<BaseLayout active="none" description="Hermes Agent Playbook 条款说明。" locale="zh" path="/terms/" title="条款 | Hermes Agent Playbook">
  <article class="section card page-prose">
    <h1>条款</h1>
    <Content components={{ Callout }} />
  </article>
</BaseLayout>
