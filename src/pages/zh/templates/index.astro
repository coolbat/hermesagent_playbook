---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TemplatesTabs from "@/components/TemplatesTabs.astro";
import { templatesIntro } from "@/content/templates";
import { localizePath } from "@/lib/i18n";

const locale = "zh";
---

<BaseLayout active="templates" description={templatesIntro.summary.zh} locale={locale} path="/templates/" title="Hermes Agent 模板目录">
  <PageHero
    className="page-hero templates-hero"
    ctas={[
      { href: "#templates-directory", label: "按工作目标浏览", variant: "primary" },
      { href: localizePath("/#quick-start", locale), label: "先回看 Quick Start", variant: "secondary" },
    ]}
    kicker={templatesIntro.kicker}
    summary={templatesIntro.summary.zh}
    title={templatesIntro.title.zh}
  />
  <div id="templates-directory">
    <TemplatesTabs locale={locale} />
  </div>
</BaseLayout>
