---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SkillsPanel from "@/components/SkillsPanel.astro";
import { skillsIntro } from "@/content/skills";

const locale = "zh";
---

<BaseLayout active="skills" description={skillsIntro.summary.zh} locale={locale} path="/skills/" title="Hermes Agent Skills">
  <PageHero
    className="page-hero skills-hero"
    kicker={skillsIntro.kicker}
    summary={skillsIntro.summary.zh}
    title={skillsIntro.title.zh}
  />
  <SkillsPanel locale={locale} />
</BaseLayout>
