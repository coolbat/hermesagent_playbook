---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/Callout.astro";
import { getEntryBySlug } from "@/lib/content";

const entry = await getEntryBySlug("pages", "zh", "about");
if (!entry) {
  throw new Error("Missing pages/about zh content");
}

const { Content } = await entry.render();
---

<BaseLayout active="none" description="关于 Hermes Agent Playbook。" locale="zh" path="/about/" title="关于 | Hermes Agent Playbook">
  <article class="section card page-prose">
    <h1>关于</h1>
    <Content components={{ Callout }} />
  </article>
</BaseLayout>
