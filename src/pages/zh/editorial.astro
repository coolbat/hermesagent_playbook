---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/Callout.astro";
import { getEntryBySlug } from "@/lib/content";

const entry = await getEntryBySlug("pages", "zh", "editorial");
if (!entry) {
  throw new Error("Missing pages/editorial zh content");
}

const { Content } = await entry.render();
---

<BaseLayout active="none" description="Hermes Agent Playbook 编辑政策。" locale="zh" path="/editorial/" title="编辑政策 | Hermes Agent Playbook">
  <article class="section card page-prose">
    <h1>编辑政策</h1>
    <Content components={{ Callout }} />
  </article>
</BaseLayout>
