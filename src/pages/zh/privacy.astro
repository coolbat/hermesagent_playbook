---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/Callout.astro";
import { getEntryBySlug } from "@/lib/content";

const entry = await getEntryBySlug("pages", "zh", "privacy");
if (!entry) {
  throw new Error("Missing pages/privacy zh content");
}

const { Content } = await entry.render();
---

<BaseLayout active="none" description="Hermes Agent Playbook 隐私说明。" locale="zh" path="/privacy/" title="隐私 | Hermes Agent Playbook">
  <article class="section card page-prose">
    <h1>隐私</h1>
    <Content components={{ Callout }} />
  </article>
</BaseLayout>
