---
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = "zh";
---

<BaseLayout active="none" description="搜索 Hermes Agent 的教程、模板与排错内容。" locale={locale} path="/search/" title="搜索 | Hermes Agent Playbook">
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </Fragment>

  <section class="section search-page search-page--zh">
    <div class="search-shell card">
      <p class="eyebrow">SEARCH</p>
      <h1>更快找到下一条有用答案。</h1>
      <p class="sub">在 Quick Start、Learn、Templates、Troubleshoot 和信任页之间统一搜索，不需要离开这个 playbook。</p>
      <div class="search-root" id="search-root">
        <p class="search-loading">正在加载搜索…</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const loadPagefindUi = async () => {
      if (window.PagefindUI) return window.PagefindUI;

      await new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-pagefind-ui]');
        if (existing instanceof HTMLScriptElement) {
          existing.addEventListener("load", () => resolve(window.PagefindUI), { once: true });
          existing.addEventListener("error", reject, { once: true });
          return;
        }

        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.async = true;
        script.dataset.pagefindUi = "true";
        script.addEventListener("load", () => resolve(window.PagefindUI), { once: true });
        script.addEventListener("error", reject, { once: true });
        document.head.appendChild(script);
      });

      return window.PagefindUI;
    };

    const initSearch = async () => {
      const root = document.querySelector("#search-root");
      if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

      try {
        root.innerHTML = "";
        const PagefindUI = await loadPagefindUi();
        if (!PagefindUI) {
          throw new Error("Pagefind UI script loaded but window.PagefindUI is missing");
        }

        new PagefindUI({
          element: "#search-root",
          bundlePath: "/pagefind/",
          showImages: false,
          showSubResults: true,
          resetStyles: false,
          autofocus: true,
          translations: {
            placeholder: "搜索教程、模板和排错内容",
            zero_results: "暂时没有结果，试试症状、主题或标签。",
            clear_search: "清除搜索",
            load_more: "加载更多结果",
          },
        });
        root.dataset.ready = "true";
      } catch (error) {
        root.innerHTML = '<p class="search-loading">搜索加载失败。请刷新一次，并确认 <code>/pagefind/pagefind-ui.js</code> 可以访问。</p>';
        console.error("Failed to initialize search", error);
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSearch, { once: true });
    } else {
      initSearch();
    }
  </script>
</BaseLayout>
