---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocalizedCollection, getRouteSlug, getTranslationStatus } from "@/lib/content";
import { localizePath, pickLocalizedList } from "@/lib/i18n";
import { getQuickStartMeta, getQuickStartNeighbors } from "@/lib/source-content";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("quickStart", "zh");
  return entries.map((entry) => ({ params: { slug: getRouteSlug(entry) }, props: { entry } }));
}

const locale = "zh";
const { entry } = Astro.props;
const slug = getRouteSlug(entry);
const meta = getQuickStartMeta(slug);
const neighbors = getQuickStartNeighbors(slug);
const translationStatus = await getTranslationStatus("quickStart", locale, entry);
const { Content, headings } = await entry.render();
const formatDate = new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium" });
---

<BaseLayout
  active="home"
  description={entry.data.summary}
  locale={locale}
  ogType="article"
  path={`/quick-start/${slug}/`}
  publishedAt={entry.data.publishedAt}
  title={`${entry.data.title} | Hermes Agent Playbook`}
  updatedAt={entry.data.updatedAt}
>
  <section class="section">
    <div class="detail-layout">
      <article class="card page-prose">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href={localizePath("/", locale)}>首页</a>
          <span>/</span>
          <a href={localizePath("/#quick-start", locale)}>Quick Start</a>
          <span>/</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>
        <div class="detail-context">
          {meta?.step && <span class="detail-chip">{meta.step}</span>}
          {entry.data.readingTime && <span class="detail-chip">{entry.data.readingTime}</span>}
          {entry.data.updatedAt && <span class="detail-chip">更新于 {formatDate.format(entry.data.updatedAt)}</span>}
        </div>
        <h1>{entry.data.title}</h1>
        <p class="sub detail-lead">{entry.data.summary}</p>
        <Content />
        <div class="detail-nav">
          {neighbors.previous && <a class="detail-nav-link" href={localizePath(`/quick-start/${neighbors.previous.slug}`, locale)}>上一步：{neighbors.previous.title.zh}</a>}
          {neighbors.next && <a class="detail-nav-link" href={localizePath(`/quick-start/${neighbors.next.slug}`, locale)}>下一步：{neighbors.next.title.zh}</a>}
        </div>
      </article>
      <aside class="detail-sidebar">
        {translationStatus.status !== "ok" && (
          <div class="card translation-note">
            <p class="eyebrow">翻译状态</p>
            <p>{translationStatus.status === "missing" ? "这篇 Quick Start 文章还没有英文版本。" : "英文版本可能比当前中文版本更新。"}</p>
          </div>
        )}
        {headings.length > 0 && (
          <div class="card detail-sidebar-card">
            <p class="eyebrow">页内导航</p>
            <nav aria-label="On this page" class="toc-nav">
              {headings.map((heading) => <a class:list={["toc-link", heading.depth > 2 && "is-nested"]} href={`#${heading.slug}`}>{heading.text}</a>)}
            </nav>
          </div>
        )}
        {meta && (
          <div class="card">
            <p class="eyebrow">本步骤目标</p>
            <ul>
              {pickLocalizedList(meta.bullets, locale).map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}
        <a class="btn secondary" href={localizePath("/", locale) + "#quick-start"}>回到 Quick Start</a>
      </aside>
    </div>
  </section>
</BaseLayout>
