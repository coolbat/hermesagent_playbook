---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TroubleshootTabs from "@/components/TroubleshootTabs.astro";
import { troubleshootIntro } from "@/content/troubleshoot";
import { localizePath } from "@/lib/i18n";

const locale = "zh";
---

<BaseLayout active="troubleshoot" description={troubleshootIntro.summary.zh} locale={locale} path="/troubleshoot/" title="Hermes Agent 排错指南">
  <PageHero
    className="page-hero troubleshoot-hero"
    ctas={[
      { href: "#troubleshoot-directory", label: "按症状浏览", variant: "primary" },
      { href: localizePath("/#quick-start", locale), label: "返回 Quick Start", variant: "secondary" },
    ]}
    kicker={troubleshootIntro.kicker}
    summary={troubleshootIntro.summary.zh}
    title={troubleshootIntro.title.zh}
  />
  <TroubleshootTabs locale={locale} />
</BaseLayout>
