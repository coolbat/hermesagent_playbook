---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TroubleshootTabs from "@/components/TroubleshootTabs.astro";
import { troubleshootIntro } from "@/content/troubleshoot";
import { localizePath } from "@/lib/i18n";

const locale = "en";
---

<BaseLayout active="troubleshoot" description={troubleshootIntro.summary.en} locale={locale} path="/troubleshoot/" title="Troubleshooting Hermes Agent">
  <PageHero
    className="page-hero troubleshoot-hero"
    ctas={[
      { href: "#troubleshoot-directory", label: "Browse symptom groups", variant: "primary" },
      { href: localizePath("/#quick-start", locale), label: "Back to Quick Start", variant: "secondary" },
    ]}
    kicker={troubleshootIntro.kicker}
    summary={troubleshootIntro.summary.en}
    title={troubleshootIntro.title.en}
  />
  <TroubleshootTabs locale={locale} />
</BaseLayout>
