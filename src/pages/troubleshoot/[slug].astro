---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocalizedCollection, getRouteSlug, getTranslationStatus } from "@/lib/content";
import { localizePath, pickLocalizedList, pickLocalizedText } from "@/lib/i18n";
import { getTroubleshootMeta, getTroubleshootNeighbors } from "@/lib/source-content";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("troubleshoot", "en");
  return entries.map((entry) => ({ params: { slug: getRouteSlug(entry) }, props: { entry } }));
}

const locale = "en";
const { entry } = Astro.props;
const slug = getRouteSlug(entry);
const meta = getTroubleshootMeta(slug);
const neighbors = getTroubleshootNeighbors(slug);
const translationStatus = await getTranslationStatus("troubleshoot", locale, entry);
const { Content, headings } = await entry.render();
const formatDate = new Intl.DateTimeFormat("en-US", { dateStyle: "medium" });
---

<BaseLayout active="troubleshoot" description={entry.data.summary} locale={locale} ogType="article" path={`/troubleshoot/${slug}/`} publishedAt={entry.data.publishedAt} title={`${entry.data.title} | Hermes Agent Playbook`} updatedAt={entry.data.updatedAt}>
  <section class="section">
    <div class="detail-layout">
      <article class="card page-prose">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href={localizePath("/", locale)}>Home</a>
          <span>/</span>
          <a href={localizePath("/troubleshoot/", locale)}>Troubleshoot</a>
          <span>/</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>
        <div class="detail-context">
          {meta && <span class="detail-chip">{pickLocalizedText(meta.category, locale)}</span>}
          {meta && <span class="detail-chip">{pickLocalizedText(meta.symptom, locale)}</span>}
          {entry.data.updatedAt && <span class="detail-chip">Updated {formatDate.format(entry.data.updatedAt)}</span>}
        </div>
        <h1>{entry.data.title}</h1>
        <p class="sub detail-lead">{entry.data.summary}</p>
        <Content />
        <div class="detail-nav">
          {neighbors.previous && <a class="detail-nav-link" href={localizePath(`/troubleshoot/${neighbors.previous.slug}`, locale)}>Previous: {neighbors.previous.title.en}</a>}
          {neighbors.next && <a class="detail-nav-link" href={localizePath(`/troubleshoot/${neighbors.next.slug}`, locale)}>Next: {neighbors.next.title.en}</a>}
        </div>
      </article>
      <aside class="detail-sidebar">
        {translationStatus.status !== "ok" && (
          <div class="card translation-note">
            <p class="eyebrow">Translation status</p>
            <p>{translationStatus.status === "missing" ? "This troubleshooting guide does not have a Chinese translation yet." : "The Chinese translation may be older than this English troubleshooting guide."}</p>
          </div>
        )}
        {headings.length > 0 && (
          <div class="card detail-sidebar-card">
            <p class="eyebrow">On this page</p>
            <nav aria-label="On this page" class="toc-nav">
              {headings.map((heading) => <a class:list={["toc-link", heading.depth > 2 && "is-nested"]} href={`#${heading.slug}`}>{heading.text}</a>)}
            </nav>
          </div>
        )}
        {meta && (
          <div class="card">
            <p class="eyebrow">First checks</p>
            <ul>
              {pickLocalizedList(meta.checks, locale).map((item) => <li>{item}</li>)}
            </ul>
            <div class="tag-row">
              {pickLocalizedList(meta.commonCauses, locale).map((item) => <span class="tag">{item}</span>)}
            </div>
          </div>
        )}
        <a class="btn secondary" href={localizePath("/troubleshoot/", locale)}>Back to Troubleshoot</a>
      </aside>
    </div>
  </section>
</BaseLayout>
