---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SkillsPanel from "@/components/SkillsPanel.astro";
import { skillsIntro } from "@/content/skills";

const locale = "en";
---

<BaseLayout active="skills" description={skillsIntro.summary.en} locale={locale} path="/skills/" title="Hermes Agent Skills">
  <PageHero
    className="page-hero skills-hero"
    kicker={skillsIntro.kicker}
    summary={skillsIntro.summary.en}
    title={skillsIntro.title.en}
  />
  <SkillsPanel locale={locale} />
</BaseLayout>
