---
const { entry, href, locale } = Astro.props as {
  entry: {
    title: string;
    symptom: string;
    summary: string;
    commonCauses: string[];
    checks: string[];
  };
  href: string;
  locale: "en" | "zh";
};
---

<article class="card troubleshoot-card">
  <div class="troubleshoot-card-head">
    <h3>{entry.title}</h3>
    <p class="meta">{entry.symptom}</p>
  </div>

  <p>{entry.summary}</p>

  <div class="troubleshoot-card-section">
    <h4 class="subhead">{locale === "zh" ? "常见原因" : "Common causes"}</h4>
    <ul class="troubleshoot-list">
      {entry.commonCauses.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="troubleshoot-card-section">
    <h4 class="subhead">{locale === "zh" ? "第一轮检查" : "First checks"}</h4>
    <ul class="troubleshoot-list">
      {entry.checks.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="cta-row">
    <a class="btn secondary" href={href}>{locale === "zh" ? "查看排错指南" : "Open guide"}</a>
  </div>
</article>
