---
const {
  entry,
  href,
  ctaLabel = "Open step guide",
} = Astro.props as {
  entry: {
    step: string;
    title: string;
    summary: string;
    bullets: string[];
  };
  href: string;
  ctaLabel?: string;
};
---

<article class="card quickstart-card">
  <p class="eyebrow">{entry.step}</p>
  <h3>{entry.title}</h3>
  <p>{entry.summary}</p>
  <ul class="card-bullets">
    {entry.bullets.map((item) => <li>{item}</li>)}
  </ul>
  <div class="cta-row">
    <a class="btn secondary card-link" href={href}>{ctaLabel}</a>
  </div>
</article>
