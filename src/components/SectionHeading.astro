---
const {
  title,
  summary,
  actionHref,
  actionLabel,
  actionVariant = "secondary",
} = Astro.props as {
  title: string;
  summary?: string;
  actionHref?: string;
  actionLabel?: string;
  actionVariant?: "primary" | "secondary" | "link";
};
---

<div class="section-head">
  <div>
    <h2>{title}</h2>
    {summary && <p class="small">{summary}</p>}
  </div>
  {actionHref && actionLabel && (
    <a class:list={["btn", actionVariant]} href={actionHref}>
      {actionLabel}
    </a>
  )}
</div>
