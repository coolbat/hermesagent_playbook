---
const {
  kicker,
  title,
  summary,
  ctas = [],
  className = "page-hero",
} = Astro.props as {
  kicker: string;
  title: string;
  summary: string;
  ctas?: { href: string; label: string; variant?: "primary" | "secondary" | "link" }[];
  className?: string;
};
---

<section class:list={["hero", !Astro.slots.has("aside") && "hero-single", className]}>
  <article class="hero-main">
    <span class="kicker">{kicker}</span>
    <h1>{title}</h1>
    <p class="sub">{summary}</p>
    {
      ctas.length > 0 && (
        <div class="cta-row">
          {ctas.map((cta) => (
            <a class:list={["btn", cta.variant ?? "secondary"]} href={cta.href}>
              {cta.label}
            </a>
          ))}
        </div>
      )
    }
    <slot />
  </article>
  {Astro.slots.has("aside") && <aside class="hero-side"><slot name="aside" /></aside>}
</section>
